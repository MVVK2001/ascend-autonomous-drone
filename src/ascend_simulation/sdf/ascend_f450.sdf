<?xml version="1.0"?>
<sdf version="1.9">

  <model name="ascend_f450">

    <static>false</static>

    <link name="base_link">

      <pose>0 0 1 0 0 0</pose>

      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.03278</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.03278</iyy>
          <iyz>0</iyz>
          <izz>0.05973</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.32 0.32 0.10</size>
          </box>
        </geometry>
      </collision>

      <!-- Main frame -->
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>file:///home/administrator/ascend_ws/src/ascend_f450_description/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Front Left (Motor 3 - CW) -->
      <visual name="rotor1_visual">
        <pose>0.15891 0.15890 0.079639 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/administrator/ascend_ws/src/ascend_f450_description/meshes/rotor1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>

      <!-- Front Right (Motor 1 - CCW) -->
      <visual name="rotor2_visual">
        <pose>0.15890 -0.15891 0.079639 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/administrator/ascend_ws/src/ascend_f450_description/meshes/rotor2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <!-- Rear Right (Motor 4 - CW) -->
      <visual name="rotor3_visual">
        <pose>-0.15891 -0.15890 0.079639 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/administrator/ascend_ws/src/ascend_f450_description/meshes/rotor3.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>

      <!-- Rear Left (Motor 2 - CCW) -->
      <visual name="rotor4_visual">
        <pose>-0.15890 0.15891 0.079639 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/administrator/ascend_ws/src/ascend_f450_description/meshes/rotor4.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>
      
    <!-- ========================= -->
    <!-- IMU SENSOR               -->
    <!-- ========================= -->

    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>

    </sensor>

    <!-- ========================= -->
    <!-- DOWNWARD CAMERA          -->
    <!-- ========================= -->

    <sensor name="survey_camera" type="camera">

      <pose>0 0 -0.05 0 3.14159 0</pose>

      <always_on>true</always_on>
      <update_rate>30</update_rate>

      <camera>

        <horizontal_fov>1.57</horizontal_fov>

        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.1</near>
          <far>500</far>
        </clip>

      </camera>

      <visualize>true</visualize>

    </sensor>

    <!-- ========================= -->
    <!-- MTF-01 RANGEFINDER       -->
    <!-- ========================= -->

    <sensor name="rangefinder" type="ray">

      <pose>0 0 -0.05 0 -1.5708 0</pose>
      <always_on>true</always_on>

      <update_rate>50</update_rate>
      <topic>/rangefinder</topic>

      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>

      </ray>

    </sensor>

    </link>

  </model>

</sdf>
